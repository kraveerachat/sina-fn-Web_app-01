    fetchIncome();

    const handleMutate = () => fetchIncome();
    window.addEventListener('app_mutate', handleMutate);
    return () => window.removeEventListener('app_mutate', handleMutate);
  }, [fetchIncome]);

  return { annualIncome, loading, error, refetch: fetchIncome };
