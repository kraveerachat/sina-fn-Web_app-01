  if (!isSupabaseConfigured()) throw new Error('Supabase not configured');

  const startDate = `${year}-01-01`;
  const endDate   = `${year}-12-31`;

  const { data, error } = await supabase
    .from('transactions')
    .select('amount')
    .eq('user_id', userId)
    .eq('type', 'income')
    .gte('transaction_date', startDate)
