        {/* Sliding thumb — solid square */}
        <motion.div
          layout
          animate={{ x: checked ? 20 : 2 }}
          transition={{ type: 'spring', stiffness: 500, damping: 30 }}
          className={cn(
            'absolute top-1 w-4 h-4',
            'rounded-none',
            checked ? c.thumb : 'bg-[var(--cyber-text-muted)]',
