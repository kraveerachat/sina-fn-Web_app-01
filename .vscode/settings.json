{
  // ════════════════════════════════════════════════════════
  // CSS Validation — fully disabled for Tailwind v4 compat
  // ════════════════════════════════════════════════════════
  //
  // VS Code's built-in CSS language server does not understand:
  //   • Tailwind v4 directives  (@tailwind, @theme, @utility, @layer)
  //   • v4 gradient classes     (bg-linear-to-br, bg-linear-to-r, …)
  //   • Arbitrary CSS variables (from-[var(--x)], via-[var(--y)])
  //
  // Disabling all three built-in validators eliminates every
  // yellow squiggle that originates from the CSS linter.
  "css.validate": false,
  "less.validate": false,
  "scss.validate": false,

  // Belt-and-suspenders: individual lint rule overrides
  // (active only when css.validate is true, kept for safety)
  "css.lint.unknownAtRules": "ignore",
  "css.lint.unknownProperties": "ignore",
  "css.lint.validProperties": [],

  // ════════════════════════════════════════════════════════
  // Tailwind CSS IntelliSense — v4 configuration
  // ════════════════════════════════════════════════════════
  //
  // Point the extension at the CSS entry point (not tailwind.config.js)
  // so it learns all @theme variables and custom utilities.
  // Path must be relative to the WORKSPACE ROOT (the folder VS Code opens).
  "tailwindCSS.experimental.configFile": "app/globals.css",

  // ── Suppress ALL Tailwind IntelliSense yellow squiggles ───────────────
  //
  // These rules fire false-positives on:
  //   • from-[var(--cyber-surface)], via-[var(--cyber-cyan)], etc.
  //     → arbitrary values using project CSS variables
  //   • bg-linear-to-br, bg-linear-to-r (Tailwind v4 gradient API)
  //   • @theme, @utility, @layer blocks in globals.css
  //   • Any class the extension doesn't recognise from its own manifest
  //
  "tailwindCSS.lint.invalidTailwindDirective": "ignore",
  "tailwindCSS.lint.unknownAtRules": "ignore",
  "tailwindCSS.lint.cssConflict": "ignore",
  "tailwindCSS.lint.recommendedVariantOrder": "ignore",
  "tailwindCSS.lint.invalidScreen": "ignore",
  "tailwindCSS.lint.invalidVariant": "ignore",
  "tailwindCSS.lint.invalidConfigPath": "ignore",

  // Teach the extension to recognize class strings inside cn() and cva()
  "tailwindCSS.experimental.classRegex": [
    ["cn\\(([^)]*)\\)", "\"([^\"]*)\""],
    ["cva\\(([^)]*)\\)", "\"([^\"]*)\""]
  ],

  // ════════════════════════════════════════════════════════
  // TypeScript
  // ════════════════════════════════════════════════════════
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "typescript.suggest.autoImports": true,

  // ════════════════════════════════════════════════════════
  // ESLint
  // ════════════════════════════════════════════════════════
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],

  // ════════════════════════════════════════════════════════
  // File watcher — exclude heavy generated dirs
  // ════════════════════════════════════════════════════════
  "typescript.tsserver.watchOptions": {},
  "files.watcherExclude": {
    "**/.next/**": true,
    "**/node_modules/**": true
  }
}
